{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key_id",
    "payload",
    "signature"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "payload": {
      "type": "string",
      "maxLength": 43691,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScrumeVPN exact-byte envelope v1"
}
